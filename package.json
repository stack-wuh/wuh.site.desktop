{
  "name": "@wuh.site/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "通用 Markdown 桌面编辑器 — GitHub 深度集成",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --dir",
    "dist:mac": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@octokit/rest": "^21.0.0",
    "codemirror": "^6.0.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.7.2",
    "vite": "6.4.1",
    "vitest": "^5.0.0"
  }
}
